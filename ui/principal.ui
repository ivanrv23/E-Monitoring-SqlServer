        <string notr="true">QPushButton {
    background-color: rgb(4, 51, 100); /* Color de fondo inicial */
    color: white; /* Color del texto */
    border:2px solid rgb(4, 51, 100); /* Borde del mismo color que el fondo */
    border-radius: 15px; /* Bordes redondeados */
    padding: 10px 20px; /* Espaciado interno del botón */
    font-size: 14px; /* Tamaño de la fuente */
    font-weight: bold; /* Texto en negrita */
}

QPushButton:hover {
    background-color: rgb(2, 32, 72); /* Color de fondo en hover */
    border: 2px solid rgb(255, 255, 255); /* Borde blanco en hover */
}

QPushButton:pressed {
    background-color: rgb(0, 30, 60); /* Color al hacer clic (pressed) */
}
QWidget {
    background-color: rgb(4, 51, 100); /* Color de fondo del frame */
}
QToolTip {
    font-family: &quot;Times New Roman&quot;, serif; /* Fuente elegante */
    font-size: 18px;                      /* Tamaño de la fuente */
    font-style: italic;                   /* Estilo cursiva */
}</string>
