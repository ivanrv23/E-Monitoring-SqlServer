          <property name="styleSheet">
           <string notr="true">/* Estilos para QPushButton */
QPushButton {
    border-radius: 5px; /* Borde redondeado */
    padding: 3px 1px; /* Espaciado más cómodo dentro del botón */
    background-color: rgb(240, 240, 240); /* Fondo claro inicial */
    border: 1px solid rgb(200, 200, 200); /* Borde gris claro */
    color: rgb(4, 51, 100); /* Color de texto acorde al borde en hover */
}

QPushButton:hover {
    background-color: rgb(230, 230, 230); /* Fondo ligeramente más claro en hover */
    border: 1px solid rgb(4, 51, 100); /* Borde azul más elegante al hacer hover */
}

QPushButton:pressed {
    background-color: rgb(200, 200, 200); /* Fondo gris más oscuro cuando se presiona */
    border: 1px solid rgb(4, 51, 100); /* Mantener el borde azul al presionar */
}
/* Estilo para el QComboBox */
QComboBox {
    border-radius: 5px; /* Bordes redondeados igual que en los botones */
    padding: 2px 5px; /* Reducir el espaciado para hacer el combo más delgado */
    background-color: rgb(240, 240, 240); /* Fondo claro igual que en los botones */
    border: 1px solid rgb(200, 200, 200); /* Borde gris claro como en los botones */
}

/* Estilo para el popup (el menú desplegable) */
QComboBox QAbstractItemView {
    background-color: rgb(240, 240, 240); /* Fondo claro */
    border: 1px solid rgb(200, 200, 200); /* Borde gris claro */
}

/* Estilo al hacer hover (cuando el mouse está sobre el QComboBox) */
QComboBox:hover {
    background-color: rgb(230, 230, 230); /* Fondo ligeramente más claro en hover */
    border: 1px solid rgb(4, 51, 100); /* Borde azul más elegante al hacer hover */
}

/* Estilo al presionar el QComboBox */
QComboBox:pressed, QComboBox:on {
    background-color: rgb(200, 200, 200); /* Fondo gris más oscuro al presionar */
    border: 1px solid rgb(4, 51, 100); /* Mantener el borde azul al presionar */
}

/* Estilos para QSpinBox */
QSpinBox {
    padding: 2px 5px; /* Espaciado cómodo */
    background-color: rgb(240, 240, 240); /* Fondo claro inicial */
    border: 1px solid rgb(200, 200, 200); /* Borde gris claro */
}

QSpinBox:hover {
    background-color: rgb(230, 230, 230); /* Fondo más claro al hacer hover */
    border: 1px solid rgb(4, 51, 100); /* Borde azul elegante en hover */
}

QSpinBox:pressed {
    background-color: rgb(200, 200, 200); /* Fondo gris oscuro al presionar */
    border: 1px solid rgb(4, 51, 100); /* Mantener el borde azul al presionar */
}

/* Estilos para QDoubleSpinBox */
QDoubleSpinBox {
    padding: 2px 3px; /* Espaciado cómodo */
    background-color: rgb(240, 240, 240); /* Fondo claro */
    border: 1px solid rgb(200, 200, 200); /* Borde gris claro */
}

QDoubleSpinBox:hover {
    background-color: rgb(230, 230, 230); /* Fondo más claro al hacer hover */
    border: 1px solid rgb(4, 51, 100); /* Borde azul en hover */
}

QDoubleSpinBox:pressed {
    background-color: rgb(200, 200, 200); /* Fondo gris oscuro al presionar */
    border: 1px solid rgb(4, 51, 100); /* Mantener el borde azul al presionar */
}

/* Estilo para el scroll horizontal */
QScrollBar:horizontal {
    height: 4px; /* Grosor del scrollbar horizontal */
    background: #f1f1f1; /* Color de fondo del scroll */
    margin: 0px 0px 0px 0px;
    border-radius: 4px; /* Esquinas curvas para el contenedor del scrollbar */
    border: none;
}

QScrollBar::handle:horizontal {
    background: #888; /* Color de la barra de desplazamiento */
    min-width: 20px; /* Tamaño mínimo del handle del scroll */
    border-radius: 2px; /* Esquinas curvas del handle */
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Estilo para el scroll vertical */
QScrollBar:vertical {
    width: 4px; /* Grosor del scrollbar vertical */
    background: #f1f1f1; /* Color de fondo del scroll */
    margin: 0px 0px 0px 0px;
    border-radius: 4px; /* Esquinas curvas para el contenedor del scrollbar */
    border: none;
}

QScrollBar::handle:vertical {
    background: #888; /* Color de la barra de desplazamiento */
    min-height: 20px; /* Tamaño mínimo del handle del scroll */
    border-radius: 2px; /* Esquinas curvas del handle */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
</string>
