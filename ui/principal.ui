    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #E0E0E0, stop:1 rgb(250, 250, 250)); /* Colores más suaves */
    border: 1px solid #6A8FAF; /* Borde más claro */
    width: 18px;
    margin: -2px 0; /* Mantiene el mismo tamaño del handle */
    border-radius: 4px;
}
